msgstr "關機附加資料必須為 6 位元組十六進位值"

msgid "Shutting down host"
msgstr "正在關閉主機"

msgid "Sending Ethernet shutdown frame…"
msgstr "正在傳送乙太網路關機訊框…"

msgid "Shutdown frame sent"
msgstr "關機訊框已傳送"

msgid "Operation failed"
msgstr "操作失敗"

msgid "Execute"
msgstr "執行"
