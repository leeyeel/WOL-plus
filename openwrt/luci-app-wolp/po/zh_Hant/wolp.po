msgid "Wake on LAN Plus"
msgstr "網路喚醒+"

msgid "Action"
msgstr "操作"

msgid "Wake up"
msgstr "喚醒"

msgid "Shutdown"
msgstr "關機"

msgid "Network interface to use"
msgstr "使用的網路介面"

msgid "Send to broadcast address"
msgstr "傳送到廣播位址"

msgid "Target MAC address"
msgstr "目標 MAC 位址"

msgid "Shutdown discriminator"
msgstr "關機附加資料"

msgid "etherwake is not installed"
msgstr "未安裝 etherwake"

msgid "A target MAC address and network interface are required"
msgstr "需要目標 MAC 位址和網路介面"

msgid "Waking host"
msgstr "正在喚醒主機"

