#!/bin/sh

set -u

OPENSSL=/usr/bin/openssl
PROTOCOL=WOLP/1

NETCAT=
for candidate in /usr/bin/netcat /usr/bin/nc /bin/nc; do
	if [ -x "$candidate" ]; then
		NETCAT=$candidate
		break
	fi
done

fail() {
	echo "$1" >&2
	exit 2
}

hmac() {
	printf '%s' "$1" | "$OPENSSL" dgst -sha256 -hmac "$SECRET" -hex | sed 's/^.* //'
}

ACTION=${1:-}
HOST=${2:-}
PORT=${3:-}
MAC=${4:-}
SECRET=${5:-}

[ -n "$NETCAT" ] || fail 'netcat is not installed'
[ -x "$OPENSSL" ] || fail 'openssl is not installed'

case "$ACTION" in
	status|shutdown) ;;
	*) fail 'invalid control action' ;;
esac

printf '%s\n' "$HOST" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || fail 'invalid IPv4 address'
printf '%s\n' "$PORT" | grep -Eq '^[0-9]{4,5}$' || fail 'invalid control port'
[ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || fail 'invalid control port'
printf '%s\n' "$MAC" | grep -Eiq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || fail 'invalid MAC address'
printf '%s\n' "$SECRET" | grep -Eiq '^[0-9a-f]{64}$' || fail 'invalid control secret'

MAC=$(printf '%s' "$MAC" | tr '[:upper:]' '[:lower:]')
COMMAND=$(printf '%s' "$ACTION" | tr '[:lower:]' '[:upper:]')
TIMESTAMP=$(date +%s)
NONCE=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
CANONICAL="$PROTOCOL|$COMMAND|$MAC|$TIMESTAMP|$NONCE"
SIGNATURE=$(hmac "$CANONICAL") || fail 'failed to sign control request'
REQUEST="$PROTOCOL $COMMAND $MAC $TIMESTAMP $NONCE $SIGNATURE"

# Keep stdin open briefly so netcat can receive the UDP acknowledgement on the same socket.
RESPONSE=$( (printf '%s\n' "$REQUEST"; sleep 2) | "$NETCAT" -u -w 2 "$HOST" "$PORT" 2>/dev/null || true )
RESPONSE=$(printf '%s' "$RESPONSE" | tr -d '\r\n')

[ -n "$RESPONSE" ] || {
	printf '{"ack":false,"error":"timeout"}\n'
	exit 0
}

set -f
set -- $RESPONSE
[ "$#" -eq 9 ] || {
	printf '{"ack":false,"error":"invalid_response"}\n'
	exit 0
}

[ "$1" = "$PROTOCOL" ] && [ "$2" = 'ACK' ] && [ "$3" = "$COMMAND" ] && [ "$4" = "$MAC" ] && [ "$5" = "$TIMESTAMP" ] && [ "$6" = "$NONCE" ] || {
	printf '{"ack":false,"error":"invalid_response"}\n'
	exit 0
}

STATE=$7
DELAY=$8
RESPONSE_SIGNATURE=$9
printf '%s\n' "$DELAY" | grep -Eq '^[0-9]+$' || {
	printf '{"ack":false,"error":"invalid_response"}\n'
	exit 0
}

case "$COMMAND:$STATE" in
	STATUS:RUNNING|SHUTDOWN:SCHEDULED|SHUTDOWN:ALREADY_SCHEDULED) ;;
	*)
		printf '{"ack":false,"error":"invalid_response"}\n'
		exit 0
		;;
esac

EXPECTED=$(hmac "$PROTOCOL|ACK|$COMMAND|$MAC|$TIMESTAMP|$NONCE|$STATE|$DELAY") || fail 'failed to verify control response'
[ "$RESPONSE_SIGNATURE" = "$EXPECTED" ] || {
	printf '{"ack":false,"error":"invalid_signature"}\n'
	exit 0
}

printf '{"ack":true,"state":"%s","delay":%s}\n' "$STATE" "$DELAY"
