#!/usr/bin/ucode

'use strict';

import { access, popen } from 'fs';

const etherwake = '/usr/bin/etherwake';

function shellquote(value) {
	return "'" + replace(value, "'", "'\\''") + "'";
}

function resultFromCommand(command) {
	const fd = popen(command + ' 2>&1');
	return {
		stdout: fd.read('all'),
		stderr: '',
		code: fd.close()
	};
}

function requestArgs(request) {
	return request.args || request;
}

function validMac(value) {
	return value && match(value, /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/);
}

function validInterface(value) {
	return value && match(value, /^[A-Za-z0-9_.:-]+$/);
}

function wantsBroadcast(value) {
	return value == true || value == '1' || value == 'true';
}

function runEtherwake(args, extraData) {
	const parts = [shellquote(etherwake), shellquote('-D')];

	if (!access(etherwake, 'x'))
		return { stdout: '', stderr: 'etherwake is not installed', code: 1 };
	if (!validMac(args.mac) || !validInterface(args.interface))
		return { stdout: '', stderr: 'invalid Ethernet frame request', code: 1 };
	if (extraData && !validMac(extraData))
		return { stdout: '', stderr: 'invalid shutdown discriminator', code: 1 };

	parts.push(shellquote('-i'));
	parts.push(shellquote(args.interface));
	if (wantsBroadcast(args.broadcast))
		parts.push(shellquote('-b'));
	if (extraData) {
		parts.push(shellquote('-p'));
		parts.push(shellquote(extraData));
	}
	parts.push(shellquote(args.mac));

	return resultFromCommand(join(' ', parts));
}

const methods = {
	stat: {
		call: function() {
			return { etherwake: !!access(etherwake, 'x') };
		}
	},

	wake: {
		args: { mac: 'string', interface: 'string', broadcast: 'boolean' },
		call: function(request) {
			return runEtherwake(requestArgs(request), null);
		}
	},

	shutdown: {
		args: { mac: 'string', interface: 'string', broadcast: 'boolean', extra_data: 'string' },
		call: function(request) {
			const args = requestArgs(request);
			return runEtherwake(args, args.extra_data);
		}
	}
};

return { 'luci.wolp': methods };
