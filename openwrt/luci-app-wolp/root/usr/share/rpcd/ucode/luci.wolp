#!/usr/bin/ucode

'use strict';

import { access, open, popen } from 'fs';
import { cursor } from 'uci';

const etherwake = '/usr/bin/etherwake';
const dhcpLeaseFile = '/tmp/dhcp.leases';
const lanNeighbors = '/sbin/ip -4 neigh show dev br-lan 2>/dev/null';

function shellquote(value) {
	return "'" + replace(value, "'", "'\\''") + "'";
}

function resultFromCommand(command) {
	const fd = popen(command + ' 2>&1');
	return {
		stdout: fd.read('all'),
		stderr: '',
		code: fd.close()
	};
}

function requestArgs(request) {
	return request.args || request;
}

function validMac(value) {
	return value && match(value, /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/);
}

function normalizedMac(value) {
	return validMac(value) ? uc(value) : null;
}

function validInterface(value) {
	return value && match(value, /^[A-Za-z0-9_.:-]+$/);
}

function wantsBroadcast(value) {
	return !!value;
}

function runEtherwake(args, extraData, forceBroadcast) {
	let command;

	if (!access(etherwake, 'x'))
		return { stdout: '', stderr: 'etherwake is not installed', code: 1 };
	if (!validMac(args.mac) || !validInterface(args.interface))
		return { stdout: '', stderr: 'invalid Ethernet frame request', code: 1 };
	if (extraData && !validMac(extraData))
		return { stdout: '', stderr: 'invalid shutdown discriminator', code: 1 };

	// All variable fields have been validated as shell-safe tokens above.
	command = etherwake + ' -D -i ' + args.interface;
	if (forceBroadcast || wantsBroadcast(args.broadcast))
		command += ' -b';
	if (extraData) {
		command += ' -p ' + extraData;
	}
	command += ' ' + args.mac;

	return resultFromCommand(command);
}

function addDevice(devices, mac, name, ip, source) {
	mac = normalizedMac(mac);
	if (!mac)
		return;

	let device = devices[mac] || { mac: mac };
	devices[mac] = device;

	if (name && name != '*' && (!device.name || source == 'static'))
		device.name = name;
	if (ip && (!device.ip || source != 'neighbor'))
		device.ip = ip;
	device[source] = true;
}

function addStaticDhcpBindings(devices) {
	let config = cursor();

	config.foreach('dhcp', 'host', (host) => {
		for (let mac in host.mac || [])
			addDevice(devices, mac, host.name, host.ip, 'static');
	});
}

function addDhcpLeases(devices) {
	let fd = open(dhcpLeaseFile, 'r');
	if (!fd)
		return;

	let leases = fd.read('all') || '';
	fd.close();

	for (let line in split(leases, '\n')) {
		let lease = match(line, /^([0-9]+) ([0-9A-Fa-f:]+) ([0-9.]+) ([^ ]+)/);
		if (lease)
			addDevice(devices, lease[2], lease[4], lease[3], 'lease');
	}
}

function addLanNeighbors(devices) {
	let fd = popen(lanNeighbors),
		neighbors;

	if (!fd)
		return;

	neighbors = fd.read('all') || '';
	fd.close();

	for (let line in split(neighbors, '\n')) {
		let neighbor = match(line, /^([^ ]+) dev ([^ ]+) lladdr ([0-9A-Fa-f:]+)/);
		if (neighbor)
			addDevice(devices, neighbor[3], null, neighbor[1], 'neighbor');
	}
}

function knownDevices() {
	let devices = {},
		list = [];

	addStaticDhcpBindings(devices);
	addDhcpLeases(devices);
	addLanNeighbors(devices);

	for (let mac, device in devices) {
		push(list, {
			mac: mac,
			name: device.name,
			ip: device.ip,
			online: !!(device.lease || device.neighbor),
			source: device.static ? 'static' : (device.lease ? 'lease' : 'neighbor')
		});
	}

	return list;
}

const methods = {
	stat: {
		call: function() {
			return { etherwake: !!access(etherwake, 'x') };
		}
	},

	devices: {
		call: function() {
			return { devices: knownDevices() };
		}
	},

	wake: {
		args: { mac: 'string', interface: 'string', broadcast: true },
		call: function(request) {
			return runEtherwake(requestArgs(request), null, false);
		}
	},

	shutdown: {
		args: { mac: 'string', interface: 'string', broadcast: true, extra_data: 'string' },
		call: function(request) {
			const args = requestArgs(request);
			// A running Client must see shutdown frames even when a stale
			// LuCI form or direct RPC call omits the broadcast flag.
			return runEtherwake(args, args.extra_data, true);
		}
	}
};

return { 'luci.wolp': methods };
